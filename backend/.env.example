# Base de datos (Supabase / PostgreSQL)
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_basedatos
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Modelo de lenguaje (agente de IA)
# Crear la clave en Google AI Studio. No subir el archivo .env a Git.
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash

# Autenticación
JWT_SECRET=una_clave_secreta_larga_y_aleatoria_aqui
JWT_EXPIRE_MINUTES=480

# Correo de bienvenida para propietarios e inquilinos (HU6)
# Usar una contraseña de aplicación de Google, nunca la contraseña de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=proyectofinalaari@gmail.com
SMTP_PASSWORD=LA_CLAVE_DE_APLICACION
SMTP_FROM=AARI <proyectofinalaari@gmail.com>
SMTP_STARTTLS=true
APP_LOGIN_URL=http://localhost:5173/login

# Fotos privadas de reclamos (HU8, solo backend)
# La clave de service role nunca debe exponerse en variables VITE_* ni en Git.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_de_supabase

# Usuario administrador inicial (para el seed)
ADMIN_EMAIL=admin@aari.com
ADMIN_PASSWORD=cambiar_esta_contraseña

# Entorno
ENVIRONMENT=development
