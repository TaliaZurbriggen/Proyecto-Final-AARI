# Base de datos (Supabase / PostgreSQL)
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_basedatos
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Modelo de lenguaje (agente de IA)
# Crear la clave en Google AI Studio. No subir el archivo .env a Git.
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash
# HU15: activar el worker después de aplicar 20261011160000_hu15_busqueda_automatica.sql.
# Sin permiso externo puede buscar reclamos con especialidad ya registrada.
PROVIDER_CANDIDATES_WORKER_ENABLED=false
PROVIDER_SPECIALTY_EXTERNAL_ENABLED=false
# Opcional: reutiliza GEMINI_MODEL si no se especifica uno.
PROVIDER_SPECIALTY_MODEL=
CONTRACT_CLAUSE_MODEL=gemini-3.5-flash-lite
CONTRACT_ANALYSIS_WORKER_ENABLED=true
# Mantener en false para documentos reales hasta acordar el tratamiento de datos.
# Puede habilitarse temporalmente para material sintético o anonimizado revisado.
CONTRACT_ANALYSIS_EXTERNAL_ENABLED=false
# Ejecutable de Tesseract. En Windows se puede indicar la ruta completa.
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGE=spa
# Opcional si spa.traineddata no está en la carpeta de datos predeterminada.
# TESSDATA_PREFIX=C:\ruta\a\tessdata

# Autenticación
JWT_SECRET=una_clave_secreta_larga_y_aleatoria_aqui
JWT_EXPIRE_MINUTES=480

# Correo de bienvenida para propietarios e inquilinos (HU6)
# Usar una contraseña de aplicación de Google, nunca la contraseña de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=proyectofinalaari@gmail.com
SMTP_PASSWORD=LA_CLAVE_DE_APLICACION
SMTP_FROM=AARI <proyectofinalaari@gmail.com>
SMTP_STARTTLS=true
APP_LOGIN_URL=http://localhost:5173/login
# HU32: vigencia de la invitación de acceso, no del presupuesto (1 a 168 h).
PROVIDER_INVITATION_HOURS=24
# HU19: habilitar el portal sólo después de aplicar/verificar su migración.
AARI_QUOTE_PORTAL_ENABLED=false
# Publicación automática y cierre a las 24 h. El correo usa la outbox existente.
AARI_QUOTE_WORKER_ENABLED=false

# Bandeja de salida de reclamos (HU10)
# Reintenta hasta 3 veces; el intervalo de 1 minuto se persiste en PostgreSQL.
NOTIFICATION_WORKER_ENABLED=true
# Reserva cada intento el tiempo suficiente para completar SMTP. Puede ajustarse
# entre 30 y 3600 segundos según el entorno.
NOTIFICATION_LEASE_SECONDS=120

# HU19: transporte y solicitudes. Nada se activa al hacer pull.
# Requiere las tres migraciones HU19 y verificación del canal antes de habilitar.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_OUTBOUND_ENABLED=false
# Tres secretos diferentes. Completar sólo en .env privado del backend.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
# Hasta cinco destinatarios ya autorizados en Meta (internacional, separados por coma).
# Esta lista no registra números ni ocupa los cupos de la cuenta de prueba.
WHATSAPP_TEST_RECIPIENTS=
# Permite preparar solicitudes; el envío requiere además OUTBOUND_ENABLED y configuración válida.
QUOTE_REQUESTS_WORKER_ENABLED=false
# Recepción de presupuestos/plazos. Requiere además la migración HU19 20261025160000.
# No envía WhatsApp ni SMTP; los avisos se guardan en la bandeja de notificaciones.
QUOTE_RESPONSES_WORKER_ENABLED=false
# Nombre EXACTO e idioma de una plantilla ya aprobada; no se crea en Meta automáticamente.
QUOTE_REQUEST_TEMPLATE_NAME=
QUOTE_REQUEST_TEMPLATE_LANGUAGE=es_AR

# Fotos privadas de reclamos y PDFs de contratos (HU8/HU29, solo backend)
# La clave de service role nunca debe exponerse en variables VITE_* ni en Git.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_de_supabase

# Usuario administrador inicial (para el seed)
ADMIN_EMAIL=admin@aari.com
ADMIN_PASSWORD=cambiar_esta_contraseña

# Entorno
ENVIRONMENT=development

# HU21: habilitar solo después de aplicar y verificar su migración.
# Apagado por defecto; no llama al modelo ni entrega correos directamente.
COORDINATION_WORKER_ENABLED=false
